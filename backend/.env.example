# Database Configuration (Production PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<db-host>:5432/<dbname>?ssl=require

# Application Environment
APP_ENV=production
API_V1_STR=/api/v1

# Cryptographically Secure Authentication Secrets (generate via: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=replace_with_generated_256_bit_hex_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FACULTY_SIGNUP_SECRET=replace_with_generated_256_bit_hex_secret

# Email Service Configuration for OTP 2FA Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_EMAIL=your_email@domain.com
SMTP_FROM_NAME=College Hub
OTP_EXPIRE_MINUTES=5
OTP_CLEANUP_INTERVAL_SECONDS=300

# Book Metadata Lookup APIs (Optional)
GOOGLE_BOOKS_API_KEY=
ISBNDB_API_KEY=
