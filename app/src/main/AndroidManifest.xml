<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permission -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- R11 fix (chunk 11, wake lock for the student probing phase —
         PARTIAL_WAKE_LOCK acquire throws SecurityException without it.
         Install-time permission, no runtime prompt needed. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Bluetooth & location permissions live in :feature:attendance's
         AndroidManifest.xml and are merged into this final manifest by AGP. -->

    <application
        android:label="BLE Attendance"
        android:theme="@style/Theme.CollegeApp"
        android:usesCleartextTraffic="true">

        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
